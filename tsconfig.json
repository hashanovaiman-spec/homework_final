{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2019",
    "moduleResolution": "node",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@Shared/*": ["Shared/*"]
    },
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "Shop.Client", "**/dist"]
}
