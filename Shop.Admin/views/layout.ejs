<!DOCTYPE HTML>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SHOP PROJECT</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/normalize.css@8.0.1/normalize.css" />
    <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/roboto" />
    <link rel="stylesheet" href="/<%= process.env.ADMIN_PATH %>/css/style.css" />
</head>
<body>
<header class="header">
    <a class="brand" href="/<%= process.env.ADMIN_PATH %>">
        <div class="logo"></div>
        <span>Shop.Admin</span>
    </a>

    <% if (typeof isLoginPage === "undefined" || !isLoginPage) { %>
        <nav class="header-actions">
            <a href="/<%= process.env.ADMIN_PATH %>/new-product">Add product</a>
            <a href="/<%= process.env.ADMIN_PATH %>/auth/logout">Logout</a>
        </nav>
    <% } %>
</header>
<div class="container">
    <%- body %>
</div>
</body>
</html>
