{
  "name": "shop-project-final",
  "version": "1.0.0",
  "private": true,
  "description": "SkillFactory final backend architecture project: Express + MySQL + MVC admin + React client",
  "scripts": {
    "dev": "nodemon",
    "start": "ts-node -r tsconfig-paths/register ./index.ts",
    "build:client": "npm --prefix Shop.Client install && npm --prefix Shop.Client run build",
    "dev:client": "npm --prefix Shop.Client run dev",
    "check:client": "npm --prefix Shop.Client run typecheck"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "mysql2": "^3.12.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}